From 6c29a08d13b9fbb28c55bef869fa8055654bdb35 Mon Sep 17 00:00:00 2001
From: Bill Chan <bill910174@gmail.com>
Date: Fri, 25 Sep 2026 17:34:13 +0800
Subject: [PATCH] arm64: dts: imx8mp-frdm: drive the status LED from the
 heartbeat trigger
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A visible indication that the kernel is alive, and a change small enough to
confirm at a glance — /sys/class/leds/status/trigger should read [heartbeat]
and the green LED should pulse.

Upstream-Status: Inappropriate [configuration]
---
 arch/arm64/boot/dts/freescale/imx8mp-frdm.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-frdm.dts b/arch/arm64/boot/dts/freescale/imx8mp-frdm.dts
index 11219ee92a9f..51756ed8057f 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-frdm.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-frdm.dts
@@ -201,7 +201,7 @@ gpio-leds {
 		status {
 			label = "status";
 			gpio = <&pca6416_a 14 GPIO_ACTIVE_HIGH>;
-			default-state = "on"; /* LED GREEN */
+			linux,default-trigger = "heartbeat";
 		};
 	};
 
-- 
2.43.0

